{
  "name": "neversleep",
  "version": "1.3.0",
  "description": "Never Sleep - keeps your laptop awake while it is running",
  "main": "app/main.js",
  "author": "Ahmed Roza",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tests/state.test.js",
    "build": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.roza.neversleep",
    "productName": "Never Sleep",
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "electronLanguages": ["en", "ar"],
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Never Sleep",
      "differentialPackage": false
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^24.13.3",
    "pe-library": "^2.0.3",
    "resedit": "^3.1.1"
  }
}
